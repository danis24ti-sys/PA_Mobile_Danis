<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Logo Aplikasi -->
    <TextView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/logo_text"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Gambar Mesin Cuci -->
    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/ic_washing_machine"
        android:contentDescription="@string/illustration_desc"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintBottom_toTopOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Teks Judul Utama -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/welcome_title"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/ivIllustration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />

    <!-- Teks Deskripsi Singkat -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/welcome_description"
        android:textSize="14sp"
        android:textColor="#757575"
        android:textAlignment="center"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp" />

    <!-- Tombol Utama 'Mulai sekarang' -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/btn_start"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="#2196F3"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnWebsite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

    <!-- Tombol Tambahan 'Kunjungi Website Layanan' -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWebsite"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/btn_website"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        app:strokeColor="#2196F3"
        app:strokeWidth="2dp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnDeveloper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

    <!-- Tombol Profil Developer -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeveloper"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Profil Developer"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        app:strokeColor="#2196F3"
        app:strokeWidth="2dp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
